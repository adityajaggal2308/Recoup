# Copy this file to .env for local development (never commit the real .env).
# python-dotenv loads this automatically if you use `from dotenv import load_dotenv`,
# or just export the variable yourself before running server.py.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Set to 1 to bypass the real Anthropic API and use deterministic mock
# responses instead (src/llm_client.py) — for free local testing without
# API credits. Leave unset/0 for real Claude calls (required for submission).
# MOCK_LLM=1

# Optional pipeline tuning (defaults shown):
TOP_N_FOR_ACTION=5
OUTREACH_BUDGET=10
MAX_AUTOMATED_ATTEMPTS=3

# Only used locally by Flask's dev server; Render sets PORT automatically.
PORT=5000
